// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(cuid())
  soundcloudId Int      @unique
  username    String
  displayName String?
  avatarUrl   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tokens           Token[]
  operationLogs    OperationLog[]
  surveyResponses  SurveyResponse[]
  growthActions    GrowthAction[]
  betaSignups      BetaSignup[]
  rebrandVotes     RebrandVote[]
  // Tables owned by other feature branches (AI library chat, library indexing).
  // Declared here so `prisma db push` from this branch does not drop live
  // production data. Keep in sync when those branches change their schema.
  chatConversations       chat_conversations[]
  indexedLikes            indexed_likes[]
  indexedPlaylistTracks   indexed_playlist_tracks[]
  librarySnapshot         library_snapshots?

  @@map("users")
}

model SurveyResponse {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  soundcloudId     BigInt
  campaignId       String
  preference       String // 'ads' | 'pro' | 'donation' | 'none' | 'other'
  lifetimeInterest String? // 'interested' | 'not_interested' | 'maybe'
  comment          String?  @db.Text
  context          String // 'dashboard' | 'post-merge' | 'post-from-likes'
  operationAction  String? // 'merge' | 'from-likes'
  trackCount       Int?
  createdAt        DateTime @default(now())

  @@unique([userId, campaignId])
  @@index([campaignId, createdAt])
  @@index([preference])
  @@index([lifetimeInterest])
  @@index([soundcloudId])
  @@map("survey_responses")
}

model RebrandVote {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  soundcloudId BigInt
  campaignId   String
  // Slug of the shortlisted name they picked, or 'none' / 'no_preference'.
  nameChoice   String
  // Their own suggestion — free text, independent of nameChoice.
  nameIdea     String?
  // Feature request / anything they want built next.
  featureIdea  String?  @db.Text
  context      String   // dashboard | post-merge | post-from-likes
  createdAt    DateTime @default(now())

  @@unique([userId, campaignId])
  @@index([campaignId, createdAt])
  @@index([nameChoice])
  @@index([soundcloudId])
  @@map("rebrand_votes")
}

model BetaSignup {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  soundcloudId     BigInt
  campaignId       String
  email            String?  // PII — required only when wantsBeta is true
  rekordboxUse     String   // rekordbox_primary | rekordbox_sometimes | other_software | no
  platform         String?  // mac | windows | both
  cullMethod       String?  // dont | manual | tedious | other_tool
  featuresWanted   String?  // comma-separated slugs
  editHesitations  String?  // comma-separated slugs
  trustDirectWrite String?  // yes | maybe | xml_only
  interest         String   // very | somewhat | not
  wantsBeta        Boolean  @default(false)
  wantsCall        Boolean  @default(false)
  suggestions      String?  @db.Text // ideas for SC Toolkit or SongSwipe
  nameIdea         String?  // product name suggestion
  context          String   // dashboard | post-merge | post-from-likes
  createdAt        DateTime @default(now())

  @@unique([userId, campaignId])
  @@index([campaignId, createdAt])
  @@index([interest])
  @@index([wantsBeta])
  @@index([soundcloudId])
  @@map("beta_signups")
}

model Token {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  encrypted String   // Encrypted access token
  refresh   String   // Encrypted refresh token
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("tokens")
  @@unique([userId])
}

model OperationLog {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  soundcloudId Int?
  action       String   // 'merge' | 'from-likes' | 'bulk-unlike' | 'bulk-unfollow' | 'resolve' | 'batch-resolve' | 'proxy-download' | 'bulk-remove-reposts'
  status       String   @default("success")  // 'success' | 'split' | 'error'
  trackCount   Int      @default(0)
  itemCount    Int      @default(0)
  durationMs   Int?
  errorCode    String?
  errorMessage String?
  metadata     Json?
  clientInfo   Json?
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([soundcloudId])
  @@index([action])
  @@index([status])
  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([soundcloudId, createdAt])
  @@index([action, createdAt])
  // GIN index so admin catalog queries can unnest metadata->'trackIds' without scans
  @@index([metadata], type: Gin)
  @@map("operation_logs")
}

// ── Music catalog ───────────────────────────────────────────────────────────
// One row per SoundCloud track/playlist ever touched by an operation. Rows are
// harvested at zero API cost from track objects the app already fetches
// (playlists, likes pages, search, resolve) and enriched by ID for the rest.
// Public metadata only; not keyed to any user.

model Track {
  id              BigInt   @id // SoundCloud track ID (exceeds int32)
  title           String?
  artistName      String?
  artistId        BigInt?
  genre           String?
  genreNormalized String?
  durationMs      Int?
  access          String?  // playable | preview | blocked | gone (deleted upstream)
  permalinkUrl    String?
  resolveStatus   String   @default("pending") // pending | resolved | not_found | gone
  resolveAttempts Int      @default(0)
  firstSeenAt     DateTime @default(now())
  lastSeenAt      DateTime @default(now())

  @@index([genreNormalized])
  @@index([artistName])
  @@index([resolveStatus])
  @@index([access])
  @@index([lastSeenAt])
  @@map("tracks")
}

model Playlist {
  id          BigInt   @id // SoundCloud playlist ID
  title       String?
  ownerScId   BigInt?
  trackCount  Int?
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  @@map("playlists")
}

model GrowthAction {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  actionType       String    // 'follow' | 'like'
  targetId         BigInt    // SC user ID or track ID — track IDs already exceed int32
  targetName       String?
  targetAvatar     String?
  targetFollowers  Int?
  targetFollowings Int?
  followedBack     Boolean?  // null = unchecked, true = yes, false = no
  checkedAt        DateTime?
  reversed         Boolean   @default(false)
  reversedAt       DateTime?
  sessionId        String?
  sessionLabel     String?
  inspirationIds   String?   // comma-separated SC user IDs
  inspirationNames String?   // comma-separated usernames, parallel to inspirationIds
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([userId, actionType])
  @@index([userId, reversed])
  @@index([userId, sessionId])
  @@index([userId, followedBack])
  @@index([createdAt])
  @@map("growth_actions")
}


// ── Tables owned by other feature branches ──────────────────────────────────
// Reconstructed via `prisma db pull` from production Neon so that db push /
// migrations from this branch do not drop live data. If you merge the AI-chat
// or library-indexing branches, reconcile these with those branches' models.

model chat_conversations {
  id            String          @id
  userId        String
  title         String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime
  users         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  chat_messages chat_messages[]

  @@index([userId, updatedAt])
}

model chat_messages {
  id                 String             @id
  conversationId     String
  role               String
  content            String?
  toolName           String?
  toolArgs           Json?
  toolResult         Json?
  createdAt          DateTime           @default(now())
  chat_conversations chat_conversations @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model indexed_likes {
  id              String    @id
  userId          String
  trackId         BigInt
  title           String?
  artistName      String?
  artistId        BigInt?
  genre           String?
  genreNormalized String?
  tagList         String?
  durationMs      Int?
  likedAt         DateTime?
  access          String?
  users           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, trackId])
  @@index([userId, artistName])
  @@index([userId, genreNormalized])
}

model indexed_playlist_tracks {
  id            String  @id
  userId        String
  playlistId    BigInt
  playlistTitle String?
  trackId       BigInt
  users         User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, playlistId, trackId])
  @@index([userId, playlistId])
}

model library_snapshots {
  id                String    @id
  userId            String    @unique
  status            String    @default("stale")
  likeCount         Int       @default(0)
  playlistCount     Int       @default(0)
  likesSyncedAt     DateTime?
  playlistsSyncedAt DateTime?
  error             String?
  updatedAt         DateTime
  users             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}
